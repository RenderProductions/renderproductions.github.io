# Copy this file to .env (never commit .env, the repo is public).
# On a host (Railway, Fly.io, a VPS...), put these in its environment settings instead.

# Discord Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=

# Discord Developer Portal > your app > General Information > Application ID
DISCORD_CLIENT_ID=

# Optional: a test server ID. When set, `npm run register` puts slash commands
# only in that server, where they show up instantly (global ones can take a while).
DEV_GUILD_ID=

# Prefix for chat commands
PREFIX=r!

# Where the bot reads live market data (the file the price workflow writes)
PRICES_URL=https://renderproductions.github.io/prices.json

# Where the database file lives. Point this at a persistent volume on your host,
# or every redeploy will wipe balances.
DB_PATH=./data/rend-conomy.db

# Port for the small web API the site can call (/health, /api/leaderboard)
PORT=8080
