# Copy this file to .env (never commit .env, the repo is public).
# On a host (Railway, Fly.io, a VPS...), put these in its environment settings instead.

# Discord Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=

# Discord Developer Portal > your app > General Information > Application ID
DISCORD_CLIENT_ID=

# Optional: a test server ID. When set, `npm run register` puts slash commands
# only in that server, where they show up instantly (global ones can take a while).
DEV_GUILD_ID=

# Prefix for chat commands
PREFIX=r!

# Where the bot reads live market data (the file the price workflow writes)
PRICES_URL=https://renderproductions.github.io/prices.json

# Where the database file lives. Point this at a persistent volume on your host,
# or every redeploy will wipe balances.
DB_PATH=./data/rend-conomy.db

# Port for the small web API the site can call (/health, /api/leaderboard)
PORT=8080

# Player companies: who approves new companies.
# Your own Discord user ID (Discord: Settings > Advanced > Developer Mode, then right-click yourself > Copy User ID)
BOT_OWNER_ID=
# The Render Room's server ID (right-click the server icon > Copy Server ID). Mods there can approve too.
HOME_GUILD_ID=

# Lets the bot publish player companies to the site's exchange page.
# GitHub > Settings > Developer settings > Fine-grained tokens > Generate:
#   Repository access: only renderproductions.github.io. Permissions: Contents = Read and write,
#   and Actions = Read and write (so an empty Polygon Reserve can start a market crash).
GITHUB_TOKEN=

# The Polygon Reserve: how many Polygons the house starts with (shared by every server). Default 250000.
RESERVE_START=250000
# Optional: the market news webhook URL (the same one saved as the DISCORD_WEBHOOK secret on GitHub),
# so Polygon Reserve warnings (50%, 25%, 10%, empty) post in the market news feed.
NEWS_WEBHOOK=
