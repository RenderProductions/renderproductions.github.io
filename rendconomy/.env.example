# Copy to .env and fill in. Never commit .env: the repo is public.
BOT_NAME=RendConomy
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Register slash commands to one server only (use for the test bot). Leave empty for every server.
DEV_GUILD_ID=
PREFIX=r!
# Comma-separated Discord user ids that can use owner commands (the old BOT_OWNER_ID also works)
OWNER_IDS=
# Defaults to rendconomy/data/rendconomy.db
DB_FILE=

# Pasting in the old bot's .env is fine: DISCORD_TOKEN, DISCORD_CLIENT_ID, DEV_GUILD_ID, PREFIX and
# BOT_OWNER_ID carry over. Its other lines (DB_PATH, GITHUB_TOKEN, RESERVE_START...) are ignored for now.
# Channel id where moderator actions (give, take, freeze, wipe) are posted. Empty = not posted.
MOD_LOG_CHANNEL_ID=
# The old bot's database, for /importachievements (default: engine/data/rend-conomy.db next to this folder)
OLD_DB_FILE=
# Publishing to the site (prices, profiles, stats on the "data" branch). ONLY the main bot: set both.
# Never set PUBLISH_SITE_DATA on the test bot, or it overwrites the live site's data.
PUBLISH_SITE_DATA=
GITHUB_TOKEN=
# Market news webhook(s) for the news channel. ONLY the main bot.
NEWS_WEBHOOK=
# Server whose moderators approve new player companies (the bot owner always can)
HOME_GUILD_ID=
